# Local development database (see docker-compose.yml).
# On Railway this is injected automatically by the PostgreSQL service — do not set it there.
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/procurement_dev?schema=public"

# Load demo data on an EMPTY database via `npm run db:seed:if-empty`.
# Set this on Railway for the first deploy only, then remove it.
# SEED_DEMO_DATA=true
